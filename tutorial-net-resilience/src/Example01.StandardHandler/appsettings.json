{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Polly": "Information"
    }
  },
  "Resilience": {
    "Standard": {
      "Retry": {
        "MaxRetryAttempts": 5,
        "Delay": "00:00:00.300",
        "BackoffType": "Exponential",
        "UseJitter": true
      },
      "AttemptTimeout": { "Timeout": "00:00:01" },
      "TotalRequestTimeout": { "Timeout": "00:00:20" }
    }
  }
}
